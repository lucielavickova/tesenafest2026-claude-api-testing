# Commit messages must start with the issue ID, for example "#12 Add tasks API client".
# Merge, revert, fixup and squash commits generated by git are allowed.
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

if printf '%s' "$first_line" | grep -Eq '^#[0-9]+ .+'; then
  exit 0
fi
if printf '%s' "$first_line" | grep -Eq '^(Merge |Revert "|fixup! |squash! )'; then
  exit 0
fi

echo "commit-msg: the message must start with the issue ID, for example \"#12 Add tasks API client\"." >&2
echo "commit-msg: got \"$first_line\"" >&2
exit 1
